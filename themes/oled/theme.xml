<?xml version="1.0" encoding="UTF-8"?>
<!-- OLED: pure black everywhere, so the pixels of an OLED screen are switched off. No animations.
     The accent is left out on purpose: your system's accent color is used. -->
<theme name="OLED" author="EasyBoard" version="1.0"
       description="Pure black for OLED screens: the background, sidebar, panels and boxes are all #000000. Uses your system's accent color.">
  <colors dark="true"
          window="#000000" background="#000000" text="#f2f2f2"
          base="#000000" button="#0d0d0d" tooltip="#0d0d0d"
          sidebar="#000000" panel="#000000" board="#000000"
          control="#141414" controlBorder="#2b2b2b"/>
  <hide element="board.colors"/>
  <hide element="editor.color"/>
  <!-- every tile black, whatever color the sound has -->
  <tiles uniform="true"/>
  <tilecolor name="default" primary="#0d0d0d" secondary="#000000" text="#f2f2f2"/>
</theme>
